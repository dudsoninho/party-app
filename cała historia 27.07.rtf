\f4\b0\fs21 \AppleTypeServices \cf5 \cb3 Oto skrypt gotowy do wklejenia:\
\
(async function copyFullGeminiChat() \{\
    // 1. Znajd\uc0\u378  i kliknij wszystkie elementy rozwijaj\u261 ce tre\u347 \u263 \
    const expandButtons = document.querySelectorAll('button[aria-expanded="false"], [aria-label*="Rozwi\uc0\u324 "], [aria-label*="Expand"]');\
    expandButtons.forEach(btn => \{\
        try \{ btn.click(); \} catch (e) \{\}\
    \});\
\
    // Odczekaj chwil\uc0\u281  na rozwini\u281 cie blok\'f3w\
    await new Promise(resolve => setTimeout(resolve, 1000));\
\
    // 2. Pobierz tre\uc0\u347 \u263  czatu\
    const chatContainer = document.querySelector('main') || document.body;\
    const chatText = chatContainer.innerText;\
\
    // 3. Skopiuj tekst do schowka\
    try \{\
        await navigator.clipboard.writeText(chatText);\
        console.log("%c SUCCESS! Ca\uc0\u322 y chat zosta\u322  pomy\u347 lnie skopiowany do schowka.", "color: #00ff00; font-size: 16px; font-weight: bold;");\
        alert("Ca\uc0\u322 a tre\u347 \u263  chatu zosta\u322 a skopiowana do schowka! Mo\u380 esz j\u261  teraz wklei\u263  (Ctrl+V) np. do Notatnika.");\
    \} catch (err) \{\
        // Metoda zapasowa, gdyby navigator.clipboard zosta\uc0\u322  zablokowany\
        const textarea = document.createElement('textarea');\
        textarea.value = chatText;\
        document.body.appendChild(textarea);\
        textarea.select();\
        document.execCommand('copy');\
        document.body.removeChild(textarea);\
        alert("Ca\uc0\u322 a tre\u347 \u263  chatu zosta\u322 a skopiowana do schowka!");\
    \}\
\})();\
\
Przypomnienie: je\uc0\u347 li po wklejeniu konsola nadal blokuje akcj\u281 , wpisz w niej najpierw: allow pasting i wci\u347 nij Enter.\
